# 必填：Google AI Studio (Gemini API) 金鑰
GEMINI_API_KEY=your_gemini_api_key_here

# 選填：預設使用 gemini-3.8-flash（若無法使用會自動切換備援模型）
# GEMINI_MODEL=gemini-3.8-flash

# 至少填寫下列其中一項以抓取過去 24 小時 ぶいすぽっ！切り抜き：
# 1) YouTube Data API v3 金鑰（Google Cloud Console 申請，免費每日 10,000 quota）
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# 2) Holodex API 金鑰（可於 holodex.net 帳號設定免費取得，成員識別極準確）
HOLODEX_API_KEY=
